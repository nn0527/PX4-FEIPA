#!/bin/sh
#
# Start the ESP32 UART receiver on the TELEM2 port reserved in
# rc.board_mavlink. This script runs after the generated serial config.
#------------------------------------------------------------------------------

# Skynode base boards use TELEM2 (/dev/ttyS4) for their onboard MAVLink link.
if ver hwbasecmp 009 010 011
then
	echo "INFO [uart_rx] TELEM2 reserved on Skynode"
else
	if uart_rx start
	then
		CeilingReader start
	else
		echo "ERROR [uart_rx] failed to start on TELEM2"
	fi
fi
